{
  "name": "gmail-drive-storage-lens",
  "private": false,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "e2e": "playwright test",
    "check:csp": "node scripts/check-network.mjs",
    "check:licenses": "node scripts/check-licenses.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "live-check": "tsx scripts/live-check.ts"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "d3-array": "^3.2.5",
    "d3-chord": "^3.0.2",
    "d3-force": "^3.0.1",
    "d3-hierarchy": "^3.1.3",
    "d3-sankey": "^0.12.3",
    "d3-scale": "^4.0.3",
    "d3-shape": "^3.2.1",
    "dexie": "^4.4.7",
    "graphology": "^0.26.0",
    "graphology-communities-louvain": "^2.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "umap-js": "^1.4.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/d3-array": "^3.2.2",
    "@types/d3-chord": "^3.0.6",
    "@types/d3-force": "^3.0.10",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/d3-sankey": "^0.12.5",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.1.1",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^31.0.1",
    "license-checker-rseidelsohn": "^5.0.1",
    "oxlint": "^1.90.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.1"
  },
  "license": "AGPL-3.0-or-later",
  "description": "Open-source, browser-only Gmail and Google Drive storage analyzer and cleaner. Bring your own OAuth client; no data is collected.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shuvam-Banerji-Seal/gmail-drive-storage-lens.git"
  },
  "homepage": "https://shuvam-banerji-seal.github.io/gmail-drive-storage-lens/"
}
